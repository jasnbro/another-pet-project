# Production on ATLAS: these settings normally live in Doppler (project
# named after the app with dashes, config prd) and there is no .env there.
# See deploy/README.md -> Settings. This file is for local Docker Compose,
# or for an app not yet moved to Doppler. Never commit a real .env.
# Copy to .env (gym_log/.env locally, ~/services/gym_log/.env on ATLAS).
# .env is gitignored -- never commit real credentials.
#
# The one setting: DATABASE_URL. Unset = a local SQLite file in
# gym_log/instance/ (dev only). On ATLAS it's the gym_log database on the
# shared postgres server, with the role create_app_database.sh made:
#
#   postgres/scripts/create_app_database.sh gym_log   # prints the URL once
#
DATABASE_URL=postgresql+psycopg2://gym_log_app:changeme@postgres:5432/gym_log

# Shared Undercurrent sign-in (shared/undercurrent-identity/README.md).
# Required on Postgres; unset in local dev uses a SQLite file in instance/.
IDENTITY_DATABASE_URL=postgresql+psycopg2://undercurrent_identity_app:changeme@postgres:5432/undercurrent_identity
IDENTITY_RP_ID=undercurrentlabs.dev
IDENTITY_COOKIE_DOMAIN=.undercurrentlabs.dev
IDENTITY_PUBLIC_URL=https://gym.undercurrentlabs.dev
