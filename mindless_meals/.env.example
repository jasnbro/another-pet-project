# Copy to .env in this directory (mindless_meals/.env) for local Docker
# Compose use, or set these as real environment variables however you run
# the app. .env is gitignored -- never commit real credentials. In
# production these come from Doppler instead.

# The app reads exactly one database setting: DATABASE_URL. Leave it unset
# (or delete this line) to fall back to a local SQLite file -- no code
# changes needed either way, since persistence goes through SQLAlchemy.
# See mindless_meals/docs/database.md.
#
#   postgresql://<user>:<password>@<host>:<port>/<database>
#
# On Atlas, <host> is the postgres service's Compose name ("postgres") on
# the shared atlas-data network, e.g.:
#   DATABASE_URL=postgresql://mindless_meals:changeme@postgres:5432/mindless_meals
#
# For local development against a Postgres you're running yourself
# (e.g. via postgres/compose.dev.yml, which publishes it on localhost):
#   DATABASE_URL=postgresql://mindless_meals:changeme@localhost:5432/mindless_meals
DATABASE_URL=postgresql://mindless_meals:changeme@localhost:5432/mindless_meals
