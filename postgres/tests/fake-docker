#!/usr/bin/env bash
# Stand-in for `docker` in backup tests: `docker exec ... pg_dump ... <db>`
# prints a small fake dump. FAKE_DUMP_FAIL = space-separated databases whose
# dump fails partway (some output, then non-zero exit).
set -uo pipefail
[[ "$1" == exec ]] || { echo "fake-docker: only exec is supported" >&2; exit 2; }
db="${!#}"
if [[ " $* " == *" pg_dump "* ]]; then
  echo "-- fake dump of $db"; echo "CREATE TABLE t (id int);"
  [[ " ${FAKE_DUMP_FAIL:-} " == *" $db "* ]] && { echo "pg_dump: error: connection lost" >&2; exit 1; }
  echo "-- PostgreSQL database dump complete"; exit 0
fi
cat >/dev/null; exit 0   # psql (restore): swallow input
