# Copy to .env in this directory (postgres/.env) and fill in real values.
# .env is gitignored -- never commit real credentials.
#
# In production these come from Doppler instead; this file only documents
# what the shared postgres service (compose.yml) expects.

# Superuser credentials for the Postgres server itself, reused across
# every app's database on this server -- see postgres/README.md for how
# to add a new app's database under this same account.
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
