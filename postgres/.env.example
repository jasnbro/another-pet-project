# Copy to .env in this directory (postgres/.env) and fill in real values.
# .env is gitignored -- never commit real credentials.
#
# In production these come from Doppler instead; this file only documents
# what the shared postgres service (compose.yml) expects.

# Superuser credentials for the Postgres server itself. Individual
# applications (e.g. mindless_meals) get their own, separate role and
# database created under this server -- see
# mindless_meals/docs/database.md#database-initialization -- rather than
# using this account directly.
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
