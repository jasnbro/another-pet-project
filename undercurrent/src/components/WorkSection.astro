---
import type { Site, Work } from '../lib/content.mjs';
import ContentImage from './ContentImage.astro';
import ContentLink from './ContentLink.astro';
interface Props { settings: Site['sections']['work']; works: Work[] }
const { settings, works } = Astro.props;
const published = works.filter(w => w.published).sort((a, b) => a.order - b.order || a.slug.localeCompare(b.slug));
const featured = published.find(w => w.tier === 'featured')!;
const groups = [{ tier: 'more', label: 'more work' }, { tier: 'side', label: 'side projects' }];
---
{settings.enabled && <section class="work-section" aria-labelledby="work-label">
  <h2 class="section-label ruled-label" id="work-label">{settings.label}</h2>
  <article class="featured-work">
    <div class="featured-copy">
      <h3 class="project-title"><a href={featured.link.url}>{featured.title}</a></h3>
      <p class="project-tagline">{featured.tagline}</p>
      <div class="work-summary">{featured.summary.map(p => <p>{p}</p>)}</div>
      {featured.disclosure && <p class="disclosure">{featured.disclosure}</p>}
      <ContentLink link={featured.link} />
    </div>
    <a class="architecture-link" href={featured.link.url} aria-label={`${featured.title}: ${featured.link.label}`}>
      <ContentImage image={featured.image!} class="architecture-image" />
    </a>
  </article>
  {groups.map(group => {
    const entries = published.filter(w => w.tier === group.tier);
    return entries.length > 0 && <div class="work-group">
      <h3 class="subsection-label">{group.label}</h3>
      {entries.map(work => <article class:list={['compact-work', { 'has-thumbnail': Boolean(work.image) }]}>
        <div class="compact-heading"><h4 class="project-title"><a href={work.link.url}>{work.title}</a></h4><p class="project-tagline">{work.tagline}</p></div>
        <div class="compact-summary"><p>{work.summary[0]}</p>{work.disclosure && <p class="disclosure">{work.disclosure}</p>}</div>
        {work.image && <ContentImage image={work.image} class="work-thumbnail" />}
        <ContentLink link={work.link} />
      </article>)}
    </div>;
  })}
</section>}
