---
import type { Site } from '../lib/content.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { site: Site; title?: string }
const { site, title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.meta.title}` : site.meta.title}</title>
    <meta name="description" content={site.meta.description} />
    <meta name="theme-color" content="#1d192b" />
    <link rel="icon" type="image/png" href={site.header.logo.src} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-shell"><Header header={site.header} /><main id="main-content" tabindex="-1"><slot /></main><Footer footer={site.footer} /></div>
  </body>
</html>
